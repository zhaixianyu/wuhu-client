{
	"schemaVersion": 1,
	"id": "${mod_id}-${minecraft_version_id}",
	"version": "${mod_version}",
	"icon": "assets/${mod_id}/icon.png",
	"name": "${mod_name} for ${minecraft_version}",
	"description": "阿巴阿巴",
	"authors": [
		"zhaixianyu"
	],
	"contact": {
		"website": "${mod_homepage}",
		"homepage": "${mod_sources}",
		"sources": "${mod_sources}"
	},
	"license": "${mod_license}",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.zxy.wuhuclient.WuHuClientMod"
		],
		"modmenu": [
			"com.zxy.wuhuclient.config.ModMenu"
		]
	},
	"mixins": [
		"wuhuclient.mixins.json"
	],
	"depends": {
		"minecraft": "${minecraft_dependency}"
	},
	"custom": {
		"modmenu": {
			"parent": "${mod_id}"
		}
	}
}